# Copy this file to .env and adjust DATABASE_URL to your local PostgreSQL.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/certiflow"

PORT=4000
JWT_SECRET="dev-only-change-me-in-production"
FRONTEND_URL="http://localhost:5173"
# Base of links sent to candidates and printed in QR codes (the frontend, which proxies /api).
PUBLIC_BASE_URL="http://localhost:5173"
STORAGE_DIR="./storage"

# Business rules
DISTRICT_APPROVALS_REQUIRED=2
LARGE_BATCH_THRESHOLD=50
SLA_MINUTES=60

# Stand-in WhatsApp provider (served by the API at /mock-whatsapp).
WHATSAPP_API_URL="http://localhost:4000/mock-whatsapp"
WHATSAPP_TIMEOUT_MS=3000
# Chance (0-1) that the stand-in provider fails or hangs, to prove retries work.
MOCK_WHATSAPP_FAILURE_RATE=0.2
MOCK_WHATSAPP_TIMEOUT_RATE=0.1
